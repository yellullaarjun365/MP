# ============================================================
# AquaLife Backend Environment
# ============================================================

APP_NAME=AquaLife API
APP_VERSION=0.1.0
DEBUG=true

DATABASE_URL=postgresql+psycopg://aqualife:aqualife_dev_pw@localhost:5433/aqualife
REDIS_URL=redis://localhost:6379/0

# Generate a long random value for real deployments.
SESSION_SECRET_KEY=change-this-development-secret

# Google OAuth / OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match the redirect URI configured in Google Cloud.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Temporary development redirect after successful login.
AUTH_SUCCESS_REDIRECT_URL=http://127.0.0.1:8000/docs
