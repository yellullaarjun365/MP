@keyframes surface-light {

  from {
    opacity: 0.28;
    transform:
      translateX(-50%)
      scale(0.92);
  }

  to {
    opacity: 0.82;
    transform:
      translateX(-50%)
      scale(1.08);
  }
}

@keyframes reef-light {

  from {
    opacity: 0.24;
    transform: scale(0.9);
  }

  to {
    opacity: 0.75;
    transform: scale(1.16);
  }
}

@keyframes reef-light-two {

  from {
    opacity: 0.20;
    transform: scale(0.86);
  }

  to {
    opacity: 0.60;
    transform: scale(1.14);
  }
}

/* ---------------------------------------------------------
   CREATURE CLASSES
   --------------------------------------------------------- */

.ocean-creature-jelly-a {
  left: 0;
  top: 0;
  opacity: 0.62;
  filter:
    drop-shadow(
      0 0 18px rgba(75, 225, 255, 0.70)
    )
    saturate(1.22);
  mix-blend-mode: screen;
  animation:
    jellyfish-a
    32s
    ease-in-out
    infinite;
}

.ocean-creature-jelly-b {
  left: 0;
  top: 0;
  opacity: 0.40;
  filter:
    drop-shadow(
      0 0 14px rgba(100, 220, 255, 0.62)
    )
    saturate(1.15);
  mix-blend-mode: screen;
  animation:
    jellyfish-b
    39s
    ease-in-out
    infinite;
}

.ocean-creature-eel-a {
  left: 0;
  top: 0;
  opacity: 0.58;
  filter:
    drop-shadow(
      0 0 20px rgba(50, 225, 255, 0.78)
    )
    saturate(1.30);
  mix-blend-mode: screen;
  animation:
    eel-a
    36s
    linear
    infinite;
}

.ocean-creature-eel-b {
  left: 0;
  top: 0;
  opacity: 0.34;
  filter:
    drop-shadow(
      0 0 15px rgba(70, 215, 255, 0.70)
    );
  mix-blend-mode: screen;
  animation:
    eel-b
    43s
    linear
    infinite;
}

.ocean-creature-angler {
  left: 0;
  top: 0;
  opacity: 0.55;
  filter:
    drop-shadow(
      0 0 21px rgba(70, 215, 255, 0.75)
    );
  mix-blend-mode: screen;
  animation:
    angler
    48s
    ease-in-out
    infinite;
}

.ocean-creature-comb {
  left: 0;
  top: 0;
  opacity: 0.46;
  filter:
    drop-shadow(
      0 0 20px rgba(120, 225, 255, 0.76)
    );
  mix-blend-mode: screen;
  animation:
    comb
    41s
    ease-in-out
    infinite;
}

.ocean-creature-school-a {
  left: 0;
  top: 0;
  opacity: 0.35;
  filter:
    drop-shadow(
      0 0 14px rgba(80, 220, 255, 0.68)
    );
  mix-blend-mode: screen;
  animation:
    school-a
    25s
    linear
    infinite;
}

.ocean-creature-school-b {
  left: 0;
  top: 0;
  opacity: 0.30;
  filter:
    drop-shadow(
      0 0 13px rgba(90, 220, 255, 0.62)
    );
  mix-blend-mode: screen;
  animation:
    school-b
    29s
    linear
    infinite;
}

.ocean-creature-spotted {
  left: 0;
  top: 0;
  opacity: 0.45;
  filter:
    drop-shadow(
      0 0 18px rgba(75, 220, 255, 0.74)
    )
    saturate(1.18);
  mix-blend-mode: screen;
  animation:
    spotted
    44s
    ease-in-out
    infinite;
}

@media (prefers-reduced-motion: reduce) {

  .ocean-creature-jelly-a,
  .ocean-creature-jelly-b,
  .ocean-creature-eel-a,
  .ocean-creature-eel-b,
  .ocean-creature-angler,
  .ocean-creature-comb,
  .ocean-creature-school-a,
  .ocean-creature-school-b,
  .ocean-creature-spotted {
    animation: none !important;
  }
}

